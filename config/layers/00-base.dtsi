/ {
  keymap {
    compatible = "zmk,keymap";

    // https://zmk.dev/docs/codes

    base { // BASE
      bindings = <
        &bootloader
        &kp GRAVE &kp LT      &kp LBKT     &kp LBRC     &kp LPAR          &kp EQUAL       &kp INSERT         &trans          &kp GT       &kp RPAR     &kp RBRC     &kp RBKT     &kp EXCL      &none
        &kp TAB   &kp SEMI    &kp COMMA    &kp DOT      &kp P             &kp Y           &mo SYMB           &mo SYMB        &kp F        &kp G        &kp C        &kp R        &kp L         &kp FSLH
        &kp ENTER &kp A       &kp O        &kp E        &kp U             &kp I                                              &kp D        &kp H        &kp T        &kp N        &kp S         &kp MINUS
        &kp LSHFT &kp APOS    &kp Q        &kp J        &kp K             &kp X           &kp DEL            &kp ESC         &kp B        &kp M        &kp W        &kp V        &kp Z         &kp RSHFT
        &kp LGUI  &mo FUNC    &none        &none        &mo NUMB                                                                          &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT     &kp K_APP
                                                                          &kp LALT        &kp HOME           &kp PG_UP       &kp RALT
                                                        &kp SPACE         &kp LCTRL       &kp END            &kp PG_DN       &kp RCTRL    &kp BSPC
                                                                                          &kp ESC            &kp SPACE
      >;
    };
  };
};