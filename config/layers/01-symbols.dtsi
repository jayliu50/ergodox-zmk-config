/ {
  keymap {
    compatible = "zmk,keymap";

    // https://zmk.dev/docs/codes

    symbols { // SYMB
      bindings = <
        &bootloader
        &none        &kp N7       &kp N5       &kp N3       &kp N1        &kp N9          &none              &none           &kp N0        &kp N2       &kp N4       &kp N6       &kp N8        &tog SYMB
        &none        &none        &none        &none        &kp PERCENT   &none           &trans             &trans          &none         &none        &kp CARET    &none        &none         &none
        &none        &kp AT       &none        &kp EQUAL    &none         &kp PIPE                                           &kp DOLLAR    &kp HASH     &kp TILDE    &kp AMPS     &kp ASTRK     &none
        &none        &none        &none        &none        &kp GRAVE     &kp EXCL        &none              &none           &kp BACKSLASH &none        &none        &none        &none         &none
        &none        &trans       &trans       &trans       &trans                                                                         &none        &none        &none        &none         &none
                                                                          &trans          &none              &none           &trans
                                                            &none         &trans          &none              &none           &trans        &none
                                                                                          &trans             &trans
      >;
    };
  };
};