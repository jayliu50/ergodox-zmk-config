/ {
  keymap {
    compatible = "zmk,keymap";

    // https://zmk.dev/docs/codes

    numpad { // NUMB
      bindings = <
        &bootloader
        &none        &none        &none        &none        &none         &none       &none             &none          &none         &kp KP_NLCK      &kp KP_SLASH     &kp KP_MULTIPLY  &kp KP_MINUS         &tog NUMB
        &none        &none        &none        &none        &none         &none       &none             &none          &none         &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS          &none
        &none        &none        &none        &none        &none         &none                                        &none         &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_PLUS          &kp KP_ENTER
        &none        &none        &none        &none        &none         &none       &none             &none          &none         &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_ENTER         &none
        &none        &trans       &trans       &trans       &trans                                                                   &kp KP_N0        &kp KP_N0        &kp KP_DOT       &kp KP_ENTER         &none
                                                                          &none       &none             &none          &none
                                                            &none         &none       &none             &none          &none         &none
                                                                                      &none             &none
      >;
    };
  };
};