/ {
  keymap {
    compatible = "zmk,keymap";

    // https://zmk.dev/docs/codes

    functions { // FUNC
      bindings = <
        &bootloader
        &bootloader  &none        &none        &none        &none         &none         &none                &bootloader     &none         &kp F10      &kp F11      &kp F12      &none         &trans
        &none        &none        &none        &none        &none         &none         &kp C_VOL_UP         &none           &none         &kp F7       &kp F8       &kp F9       &none         &none
        &none        &none        &none        &none        &none         &none                                              &none         &kp F4       &kp F5       &kp F6       &none         &none
        &none        &none        &none        &none        &none         &none         &kp C_VOL_DN         &none           &none         &kp F1       &kp F2       &kp F3       &none         &none
        &none        &trans       &trans       &mo BT       &trans                                                                         &none        &none        &none        &none         &none
                                                                          &trans        &none                &kp C_VOL_UP    &trans
                                                            &none         &trans        &none                &kp C_VOL_DN    &trans         &none
                                                                                        &trans               &trans
      >;
    };
  };
};