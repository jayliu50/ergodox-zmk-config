#include "apps/clip-studio-paint.dtsi"

#define CSP_NEW_LAYER            &kp LC(LS(N))
#define CSP_FLIP_CANVAS          &hyp_F
#define CSP_NEW_VECTOR_LAYER     &hyp_L
#define CSP_COLOR_HISTORY        &hyp_C
#define CSP_COLOR_SET            &hyp_P
#define CSP_COLOR_WHEEL          &hyp_W
#define CSP_ZOOM_DOUBLE          &hyp_D

HYPER_COMBO(F)
HYPER_COMBO(L)
HYPER_COMBO(C)
HYPER_COMBO(P)
HYPER_COMBO(W)
HYPER_COMBO(D)

TAP_DANCE(CSP_UNDO_REDO, CSP_UNDO, CSP_REDO)
TAP_DANCE(CSP_LAYER, CSP_NEW_LAYER, CSP_NEW_VECTOR_LAYER)
TAP_DANCE(CSP_SELECT, CSP_SELECT_LASSO, CSP_SELECT_INVERT)
TAP_DANCE_3(CSP_ZOOM, CSP_ZOOM_ACTUAL, CSP_FIT_WINDOW, CSP_ZOOM_DOUBLE)
TAP_DANCE(CSP_COLOR_RECALL, CSP_SWAP_COLORS, CSP_COLOR_HISTORY)
TAP_DANCE(CSP_COLOR_PALETTE, CSP_COLOR_SET, CSP_COLOR_WHEEL)

/ {

  keymap {
    compatible = "zmk,keymap";

    // https://zmk.dev/docs/codes

    clip_studio_paint {
      bindings = <
        &bootloader
        &to BASE             &none               &none                &td_CSP_COLOR_PALETTE   &td_CSP_COLOR_RECALL       &none                       &kp ESC                                               &trans          &trans         &trans        &trans        &trans        &trans         &trans
        CSP_HIDE_UI          CSP_FLIP_CANVAS     &td_CSP_ZOOM         CSP_ROTATE_LEFT         CSP_ROTATE_RIGHT           CSP_RESET_VIEW              CSP_SIZE_UP                                           &trans          &trans         &trans        &trans        &trans        &trans         &trans
        &none                CSP_BLEND           CSP_FILL             CSP_BRUSH               CSP_PEN                    CSP_ERASER                                                                                        &trans         &trans        &trans        &trans        &trans         &trans
        &kp LSHFT            &none               &none                CSP_TRANSFORM           &td_CSP_SELECT             CSP_SELECT_NONE             CSP_SIZE_DOWN                                         &trans          &trans         &trans        &trans        &trans        &trans         &trans
        &none                CSP_MERGE_DOWN      &none                &none                   &td_CSP_LAYER                                                                                                                               &trans        &trans        &trans        &trans         &trans
                                                                                                                        &kp LALT                    CSP_RULERS                                                                           &trans        &trans
                                                                                              &td_CSP_UNDO_REDO         &kp LCTRL                   CSP_RULER_SNAP                                        &trans          &trans         &trans
                                                                                                                                                    CSP_RULER_SPECIAL                                     &trans
      >;
    };
  };
};
